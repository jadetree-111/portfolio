# Copy to .env and edit. .env is git-ignored and never served by the web server.

# Login code for the web UI. Leave blank: one is generated on first start and written here.
ACCESS_CODE=

# AI extraction (screenshots -> tasks / timetable). Pick one:
#  1) Anthropic directly:  ANTHROPIC_API_KEY
#  2) A relay/gateway:     ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Model and reasoning effort (optional). Some relays use their own model names: set AI_MODEL to theirs.
AI_MODEL=claude-opus-5-5
# Request features a relay rejects are switched off automatically (and logged). To pin that, list them:
# AI_DISABLE=fallbacks,format,effort
AI_EFFORT_TASKS=medium
AI_EFFORT_TIMETABLE=high
# Cap on AI calls per hour, so a stuck button cannot run up a bill
AI_HOURLY_LIMIT=40

# Server (optional)
PORT=3210
HOST=0.0.0.0
# Reaching the app through a domain or tunnel? List the hostname(s) here, comma separated.
ALLOWED_HOSTS=
